# =================================================================
# KDP INTELLIGENCE STUDIO - LOCAL CONFIGURATION EXAMPLE
# =================================================================

# Database Configuration (Default: SQLite WAL Mode, local-first)
DATABASE_URL=sqlite+aiosqlite:///data/kdp_studio.db
SYNC_DATABASE_URL=sqlite:///data/kdp_studio.db
USE_POSTGRES=false
POSTGRES_URL=

# Amazon Official PA-API Credentials (Optional - configured in Settings UI)
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_ASSOCIATE_TAG=
AMAZON_DEFAULT_MARKETPLACE=US

# Local AI Engine (Ollama / OpenAI-compatible endpoint)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# OpenAI API Key (Optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Frontend API URL
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
